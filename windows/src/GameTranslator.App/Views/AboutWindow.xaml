<Window x:Class="GameTranslator.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:GameTranslator.App.Theme"
        Title="Ludora Hakkında" Width="520" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource textPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
        <Grid Width="88" Height="88">
                        <Image Source="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Koyu temada logonun kenarı zeminden ayrılsın. -->
                        <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="19.9" />
                    </Grid>
        <TextBlock Text="Ludora" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock x:Name="Version" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,4,0,12" />
        <TextBlock Text="Konsol ve bilgisayar oyunlarındaki İngilizce altyazıları gerçek zamanlı olarak Türkçeye çevirir; çeviriyi TV'de ya da bilgisayarda oyunun üstünde gösterir."
                   TextAlignment="Center" TextWrapping="Wrap" />

        <Button Content="Lisans bilgileri" Style="{StaticResource PillButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnToggleLicense" />
        <StackPanel x:Name="LicensePanel" Visibility="Collapsed" Margin="0,12,0,0">
        <TextBlock Text="Telif ve lisans" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
            <Run Text="Copyright (C) 2026 Sinan Yorulmaz" /><LineBreak />
            <Run Text="Copyright (C) 2026 Sefflex" /><LineBreak />
            <Run Text="Modifications Copyright (C) 2026 Ludora" />
        </TextBlock>
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="This program is based on CouchSubs (https://github.com/yorulmazsinan/couchsubs) and GameTranslator (https://gitlab.com/sefflex/GameTranslator)." />
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="This program is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License version 3 as published by the Free Software Foundation. This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for more details." />
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0">
            <Run Text="Lisans: AGPL-3.0 — " /><Hyperlink NavigateUri="https://www.gnu.org/licenses/agpl-3.0.html" RequestNavigate="OnLink">https://www.gnu.org/licenses/agpl-3.0.html</Hyperlink>
        </TextBlock>
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0">
            <Run Text="Kaynak kod: " /><Hyperlink NavigateUri="https://github.com/Shuaiv2/altyazi-koprusu" RequestNavigate="OnLink">https://github.com/Shuaiv2/altyazi-koprusu</Hyperlink>
        </TextBlock>

        <TextBlock Text="Remote Play bağlantısı chiaki-ng (AGPL-3.0) ile sağlanır. Çeviri modeli: OPUS-MT, University of Helsinki (CC BY 4.0). Ayrıntılar üçüncü taraf bildiriminde." Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Ludora, Sony Interactive Entertainment veya Microsoft ile bağlantılı değildir. PlayStation ve PS5, Sony Interactive Entertainment Inc.'in; Xbox, Microsoft'un ticari markalarıdır." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Kapat" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
