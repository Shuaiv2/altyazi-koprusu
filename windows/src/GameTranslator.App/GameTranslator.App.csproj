<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GameTranslator</AssemblyName>
    <!-- Kullanıcıya görünen ad (kod adları, ad alanları ve ayar anahtarları GameTranslator kalır). -->
    <Product>Altyazı Köprüsü</Product>
    <AssemblyTitle>Altyazı Köprüsü</AssemblyTitle>
    <Description>Altyazı Köprüsü — PS5 oyun altyazılarını Türkçeye çevirip TV'ye gönderir. GameTranslator (AGPL-3.0) tabanlıdır.</Description>
    <RootNamespace>GameTranslator.App</RootNamespace>
    <ApplicationIcon>Assets\AltyaziKoprusu.ico</ApplicationIcon>
    <!-- Per-monitor DPI V2: çok monitörde katman ve ekran yakalama gerçek piksel koordinatlarıyla çalışır. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>1.5.3</Version>
    <AssemblyVersion>1.5.3.0</AssemblyVersion>
    <FileVersion>1.5.3.0</FileVersion>
    <!-- Velopack kurulum ve güncelleme kancaları WPF başlamadan çalışmalı (Program.Main). -->
    <StartupObject>GameTranslator.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Paket sunucusu (CouchSubs'ın, izinle): yeni ve düzeltilmiş paketler buradan iner (PackUpdater). Boş verilirse kapalı. -->
  <PropertyGroup>
    <GameTranslatorPacksUrl Condition="'$(GameTranslatorPacksUrl)' == ''">https://couchsubs-packs.enmera.workers.dev</GameTranslatorPacksUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GameTranslatorPacksUrl" Value="$(GameTranslatorPacksUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- Yaygın İngilizce sözcükler (SCOWL/ESDB, Kevin Atkinson; izin metni THIRD-PARTY-NOTICES.md'de). -->
    <EmbeddedResource Include="Assets\english-words.txt.gz" LogicalName="GameTranslator.App.Assets.english-words.txt.gz" />
    <!-- ShellWindow.xaml pencere simgesi olarak bunu okur; ApplicationIcon yalnız exe simgesidir. -->
    <Resource Include="Assets\AltyaziKoprusu.ico" />
    <!-- Inter (SIL Open Font License 1.1; Assets\Fonts\Inter-LICENSE): mobil uygulamayla aynı yazı tipi. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- TV uygulaması paketleri: dist/tv-app altındaki paketler tv-app/ klasörüne kopyalanır. -->
  <ItemGroup>
    <Content Include="..\..\..\dist\tv-app\*.ipk;..\..\..\dist\tv-app\*.wgt;..\..\..\dist\tv-app\*.apk" Link="tv-app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Altyazı Köprüsü Android TV uygulaması (paket com.altyazikoprusu.tv): tv/android sürüm derlemesi varsa kopyalanır. -->
    <Content Include="..\..\..\tv\android\app\build\outputs\apk\release\app-release.apk" Link="tv-app\altyazi-koprusu-tv.apk" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\tv\android\app\build\outputs\apk\release\app-release.apk')" />
  </ItemGroup>

  <!-- APK adında sürüm yok; sürüm tv/android/app/build.gradle'daki versionName'den okunup yanındaki .version dosyasına yazılır. -->
  <Target Name="TvApkVersionFile" BeforeTargets="AssignTargetPaths" Condition="Exists('..\..\..\tv\android\app\build\outputs\apk\release\app-release.apk') And Exists('..\..\..\tv\android\app\build.gradle')">
    <PropertyGroup>
      <_GradleText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\..\tv\android\app\build.gradle'))</_GradleText>
      <_TvApkVersion>$([System.Text.RegularExpressions.Regex]::Match($(_GradleText), "versionName\s+'([^']+)'").Groups[1].Value)</_TvApkVersion>
      <_TvApkVersionFile>$(IntermediateOutputPath)altyazi-koprusu-tv.version</_TvApkVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TvApkVersionFile)" Lines="$(_TvApkVersion)" Overwrite="true" Condition="'$(_TvApkVersion)' != ''" />
    <ItemGroup Condition="'$(_TvApkVersion)' != ''">
      <Content Include="$(_TvApkVersionFile)" Link="tv-app\altyazi-koprusu-tv.version" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    TV altyazı düzenleyicisi (Mac ile ortak sayfa): tv/editor/* ve tv/editor/FILES.txt'teki dosyalar (tv/ altına göre)
    çıktıda tv-web/ altına kopyalanır; editor.html "../webos/..." ile bu dosyalara göreli bakar. Dosyalar taşınmaz.
  -->
  <ItemGroup>
    <Content Include="..\..\..\tv\editor\**\*" Exclude="..\..\..\tv\editor\FILES.txt" Link="tv-web\editor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\tv\webos\subtitle-settings.js" Link="tv-web\webos\subtitle-settings.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\tv\webos\subtitle-layout.js" Link="tv-web\webos\subtitle-layout.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- PS5 Otomatik Eşleştirme Yardımcıları (Node.js & playactor betiği) -->
  <ItemGroup>
    <Content Include="..\..\..\scripts\bin\node.exe" Link="helpers\node.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\scripts\bin\node.exe')" />
    <Content Include="..\..\..\scripts\ps5-register.js" Link="helpers\ps5-register.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\scripts\ps5-register.js')" />
    <Content Include="..\..\..\scripts\ps5-register\node_modules\**\*" Link="helpers\ps5-register\node_modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\scripts\ps5-register\node_modules')" />
  </ItemGroup>

  <!-- Chiaki Taşınabilir Remote Play Motoru -->
  <ItemGroup>
    <Content Include="..\..\..\chiaki\**\*" Link="chiaki\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameTranslator.Core\GameTranslator.Core.csproj" />
    <ProjectReference Include="..\GameTranslator.Translation\GameTranslator.Translation.csproj" />
    <ProjectReference Include="..\GameTranslator.RemotePlay\GameTranslator.RemotePlay.csproj" />
    <ProjectReference Include="..\GameTranslator.Shell\GameTranslator.Shell.csproj" />
    <ProjectReference Include="..\GameTranslator.TvInstall\GameTranslator.TvInstall.csproj" />
  </ItemGroup>

</Project>
