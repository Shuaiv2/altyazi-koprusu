<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.7.4</Version>
    <AssemblyVersion>1.7.4.0</AssemblyVersion>
    <FileVersion>1.7.4.0</FileVersion>
    <Company>Ludora</Company>
    <Authors>Ludora</Authors>
    <Product>Ludora</Product>
    <Copyright>© 2026 Ludora</Copyright>
    <!-- WPF projesi Mac'te de derlenebilsin (çalıştırmak için Windows gerekir). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
